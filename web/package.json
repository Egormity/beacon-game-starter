    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
